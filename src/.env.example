CKAN_OIDC_JWKS_URI=https://keycloak.qualif-data.example.org/realms/dataizen/protocol/openid-connect/certs

# CKAN OIDC Settings
CKAN_OIDC_SCOPE=openid profile email
CKAN_OIDC_REDIRECT_URI=http://localhost:8080/user/sso_login
CKAN_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080/


# Mapping des groupes CKAN
CKAN_OIDC_GROUP_MAPPING=CKAN_admin:admin,CKAN_editor:editor,CKAN_member:member,CKAN_viewer:viewer


# Gestion des organisations via LDAP
CKAN_OIDC_ORGANIZATION_CLAIM=userOrg
CKAN_OIDC_AUTO_CREATE_ORGANIZATIONS=true
CKAN_OIDC_AUTO_ASSIGN_ORGANIZATIONS=true

EXTRA_UWSGI_OPTS=""
# CKAN_API_KEY : utilisée par les scripts (sync, OGC, etc.) pour appeler l'API CKAN.
# En dev local, start-local.sh forçe la clé du user "ckan_admin" à la valeur ci-dessous
# pour rendre les scripts utilisables sans interaction. À remplacer par un vrai token en prod.
CKAN_API_KEY=ckan-local-dev-apikey

# Gestion des organisations (groupes)
#CKAN_OIDC_ORGANIZATION_CLAIM=ckan_organizations
#CKAN_OIDC_AUTO_CREATE_ORGANIZATIONS=true
#CKAN_OIDC_AUTO_ASSIGN_ORGANIZATIONS=true


CKAN_OIDC_REDIRECT_URI=http://localhost:8080/user/sso_login
CKAN_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:8080