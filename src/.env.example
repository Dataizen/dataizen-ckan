KEYCLOAK_TOKEN_URL=https://keycloak.qualif-data.example.org/realms/master/protocol/openid-connect/token
KEYCLOAK_LOGIN=admin
KEYCLOAK_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

